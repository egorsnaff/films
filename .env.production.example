# Copy to .env.production before `npm run build:selfhost` or docker compose build.
# For Docker: same variables can live in a root `.env` file (read by compose).

# Root deploy on your own domain (use /films/ only for GitHub Pages subpath)
VITE_BASE_PATH=/

VITE_KINOPOISK_API_KEY=your-kinopoisk-api-key
VITE_KINOPOISK_API_BASE_URL=https://kinopoiskapiunofficial.tech/api

# Alloha token and embed domain whitelisted in the balancer panel.
# Until your new domain is whitelisted, keep nayteruz.github.io here —
# the site can live on films.example.com while players still use the old domain.
VITE_ALLOHA_TOKEN=your-alloha-token
VITE_PLAYER_EMBED_DOMAIN=nayteruz.github.io
VITE_ENABLE_ALLOHA=true

VITE_HDVB_TOKEN=
VITE_PLAYER_TEMPLATES=

# Docker compose only
FILMS_HTTP_PORT=8080
