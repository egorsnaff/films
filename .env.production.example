# Copy to .env on the VPS before deploy.
# ServerSpace + films.qzz.io defaults below.

# Public site address (used by nginx + Let's Encrypt)
FILMS_DOMAIN=films.qzz.io
CERTBOT_EMAIL=you@example.com

# Root deploy on your own domain (use /films/ only for GitHub Pages)
VITE_BASE_PATH=/

VITE_KINOPOISK_API_KEY=your-kinopoisk-api-key
VITE_KINOPOISK_API_BASE_URL=https://kinopoiskapiunofficial.tech/api

# Alloha token and embed domain whitelisted in the balancer panel.
# Step 1: keep nayteruz.github.io until films.qzz.io is whitelisted in Alloha.
# Step 2: set VITE_PLAYER_EMBED_DOMAIN=films.qzz.io and redeploy.
VITE_ALLOHA_TOKEN=your-alloha-token
VITE_PLAYER_EMBED_DOMAIN=nayteruz.github.io
VITE_ENABLE_ALLOHA=true

VITE_HDVB_TOKEN=
VITE_PLAYER_TEMPLATES=

# Dev / docker-compose.yml only (not used in prod stack)
FILMS_HTTP_PORT=8080
