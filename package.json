{
  "name": "films",
  "version": "1.0.0",
  "description": "Film search app powered by Kinopoisk Unofficial API.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:pages",
    "build:pages": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && VITE_BASE_PATH=/films/ vite build",
    "build:selfhost": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && VITE_BASE_PATH=/ vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "preview:selfhost": "npm run build:selfhost && vite preview --base /"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egorsnaff/films.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/egorsnaff/films/issues"
  },
  "homepage": "https://github.com/egorsnaff/films#readme",
  "dependencies": {
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
